# Badtameez Music — Server Environment Variables

# Server Port
PORT=5000

# JSON Web Token Secret Key (Change to a strong random secret)
JWT_SECRET=badtameez_prod_jwt_super_secret_key_2026_x89a

# Online Cloud Database (MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/badtameez_db?retryWrites=true&w=majority
MONGODB_URI=

# Admin Email (For receiving contact inquiries)
ADMIN_EMAIL=contact@badtameezmusic.com

# SMTP Email Dispatch Settings (Optional - for Nodemailer)
# If using Gmail, generate an "App Password" under Google Account -> Security -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=586
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Badtameez Music Studio" <no-reply@badtameezmusic.com>
